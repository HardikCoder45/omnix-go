# Use an existing remotely managed tunnel:
CLOUDFLARE_TUNNEL_TOKEN=
CHATGPT_CODE_PUBLIC_URL=https://code.example.com

# Or let ChatGPT Code create/configure a tunnel:
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CHATGPT_CODE_HOSTNAME=code.example.com
# CLOUDFLARE_ZONE_ID=
# CHATGPT_CODE_TUNNEL_NAME=chatgpt-code
