{
  "expo": {
    "name": "Retroverse",
    "slug": "retroverse-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "retroverse",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.retroverse.mobile"
    },
    "android": {
      "package": "com.retroverse.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#07080D"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
