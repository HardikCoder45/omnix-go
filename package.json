{
  "name": "omnix-go",
  "version": "0.4.0",
  "description": "OmniX Go: a secure, local-first MCP coding and computer-use harness with visual tools and durable agents.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "omnix-go": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "scripts/postinstall.mjs",
    "install.sh",
    "install.ps1",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/src/cli.js",
    "test": "vitest run --config vitest.config.mjs test/agents.test.ts test/core.test.ts test/automations.test.ts test/codex-approvals.test.ts test/whatsapp.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test --max-warnings=0",
    "postinstall": "node scripts/postinstall.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "chokidar": "^4.0.3",
    "cron-parser": "^5.10.0",
    "diff": "^8.0.2",
    "express": "^5.1.0",
    "fast-glob": "^3.3.3",
    "jose": "^6.1.0",
    "omnix-computer-use": "0.1.52",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "eslint": "^10.8.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@hono/node-server": "^2.0.12",
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.5",
    "hono": "^4.12.34",
    "nanoid": "^3.3.17"
  },
  "author": "HardikCoder45",
  "homepage": "https://github.com/HardikCoder45/omnix-go#readme",
  "bugs": {
    "url": "https://github.com/HardikCoder45/omnix-go/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HardikCoder45/omnix-go.git"
  },
  "keywords": [
    "chatgpt",
    "codex",
    "mcp",
    "model-context-protocol",
    "coding-agent",
    "computer-use",
    "developer-tools",
    "automation",
    "oauth",
    "local-first"
  ]
}
